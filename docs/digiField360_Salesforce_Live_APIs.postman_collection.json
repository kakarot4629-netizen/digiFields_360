              "raw": "{\n  \"prompt\": \"Show me top 5 accounts in Pune by annual revenue\",\n  \"maxRecords\": 5\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/ai/query"
            },
            "description": "Translates conversational English questions into executable SOQL queries dynamically."
          },
          "response": []
        }
      ]
    },
    {
      "name": "5. Model Context Protocol (MCP) JSON-RPC 2.0",
      "item": [
        {
          "name": "5.1 Discover MCP Tools (tools/list)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"tools/list\"\n}"
            },
            "url": {
              "raw": "{{mcpUrl}}"
            },
            "description": "Standard MCP method returning all available Salesforce tools and their JSON schemas."
          },
          "response": []
        },
        {
          "name": "5.2 Call Tool: sobject_query",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 2,\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"sobject_query\",\n    \"arguments\": {\n      \"soql\": \"SELECT Id, Name, Subject__c, Status__c, Priority__c FROM Work_Order__c LIMIT 5\"\n    }\n  }\n}"
            },
            "url": {
