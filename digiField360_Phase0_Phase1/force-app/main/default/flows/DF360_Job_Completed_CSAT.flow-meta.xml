<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <description>After job completes: send CSAT request WhatsApp to customer.</description>
    <label>DF360 - Job Completed CSAT</label>
    <processMetadataValues><name>BuilderType</name><value><stringValue>LightningFlowBuilder</stringValue></value></processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <status>Active</status>
    <interviewLabel>DF360 - Job Completed CSAT {!$Flow.CurrentDateTime}</interviewLabel>
    <start>
        <locationX>182</locationX><locationY>48</locationY>
        <connector><targetReference>Check_CSAT_Eligible</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters><field>Status__c</field><operator>IsChanged</operator><value><booleanValue>true</booleanValue></value></filters>
        <filters><field>Status__c</field><operator>EqualTo</operator><value><stringValue>Completed</stringValue></value></filters>
        <object>Service_Job__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <decisions>
        <name>Check_CSAT_Eligible</name><label>CSAT Eligible?</label>
        <locationX>182</locationX><locationY>158</locationY>
        <defaultConnectorLabel>Not Eligible</defaultConnectorLabel>
        <rules>
            <name>Eligible</name><conditionLogic>1 AND 2</conditionLogic>
            <conditions><leftValueReference>$Record.Account__r.Phone</leftValueReference><operator>IsNull</operator><rightValue><booleanValue>false</booleanValue></rightValue></conditions>
            <conditions><leftValueReference>$Record.CSAT_Sent__c</leftValueReference><operator>EqualTo</operator><rightValue><booleanValue>false</booleanValue></rightValue></conditions>
            <connector><targetReference>Send_CSAT</targetReference></connector><label>Has Phone and Not Sent</label>
        </rules>
    </decisions>
    <actionCalls>
        <name>Send_CSAT</name><label>Send CSAT WhatsApp</label>
        <locationX>182</locationX><locationY>278</locationY>
        <actionName>DF360_WhatsAppService</actionName><actionType>apex</actionType>
        <inputParameters><name>toMobile</name><value><elementReference>$Record.Account__r.Phone</elementReference></value></inputParameters>
        <inputParameters><name>templateName</name><value><stringValue>csat_request</stringValue></value></inputParameters>
        <inputParameters><name>paramsJson</name><value><elementReference>CSATParams</elementReference></value></inputParameters>
        <inputParameters><name>languageCode</name><value><stringValue>en</stringValue></value></inputParameters>
    </actionCalls>
    <formulas>
        <name>CSATParams</name><dataType>String</dataType>
        <expression>"[\"" &amp; {!$Record.Name} &amp; "\",\"" &amp; {!$Record.Technician__r.Name} &amp; "\"]"</expression>
    </formulas>
</Flow>
