<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <description>After Service_Job insert: send job_confirmation WhatsApp to customer.</description>
    <label>DF360 - Job Created Dispatch</label>
    <processMetadataValues><name>BuilderType</name><value><stringValue>LightningFlowBuilder</stringValue></value></processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <status>Active</status>
    <interviewLabel>DF360 - Job Created Dispatch {!$Flow.CurrentDateTime}</interviewLabel>
    <start>
        <locationX>182</locationX><locationY>48</locationY>
        <connector><targetReference>Check_Has_Phone</targetReference></connector>
        <object>Service_Job__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <decisions>
        <name>Check_Has_Phone</name><label>Customer Has Phone?</label>
        <locationX>182</locationX><locationY>158</locationY>
        <defaultConnectorLabel>No Phone</defaultConnectorLabel>
        <rules>
            <name>Has_Phone</name><conditionLogic>1</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Account__r.Phone</leftValueReference>
                <operator>IsNull</operator><rightValue><booleanValue>false</booleanValue></rightValue>
            </conditions>
            <connector><targetReference>Send_Confirmation</targetReference></connector>
            <label>Has Phone</label>
        </rules>
    </decisions>
    <actionCalls>
        <name>Send_Confirmation</name><label>Send Job Confirmation WhatsApp</label>
        <locationX>182</locationX><locationY>278</locationY>
        <actionName>DF360_WhatsAppService</actionName><actionType>apex</actionType>
        <inputParameters><name>toMobile</name><value><elementReference>$Record.Account__r.Phone</elementReference></value></inputParameters>
        <inputParameters><name>templateName</name><value><stringValue>job_confirmation</stringValue></value></inputParameters>
        <inputParameters><name>paramsJson</name><value><elementReference>JobConfirmParams</elementReference></value></inputParameters>
        <inputParameters><name>languageCode</name><value><stringValue>en</stringValue></value></inputParameters>
    </actionCalls>
    <formulas>
        <name>JobConfirmParams</name><dataType>String</dataType>
        <expression>"[\"" &amp; {!$Record.Name} &amp; "\",\"" &amp; TEXT({!$Record.Priority__c}) &amp; "\"]"</expression>
    </formulas>
</Flow>
