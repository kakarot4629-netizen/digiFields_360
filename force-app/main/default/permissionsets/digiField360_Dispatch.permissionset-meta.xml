<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>digiField360 Dispatch</label>
    <description>Additional permissions for dispatchers and service managers. Grants full CRUD on all F360 objects, access to Dispatch Board, and Smart Assignment.</description>
    <hasActivationRequired>false</hasActivationRequired>

    <!-- Full CRUD on Work Orders -->
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>true</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Work_Order__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>

    <!-- Full access on Technician records -->
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Technician__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>

    <!-- Read Job History -->
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Job_History__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>

    <!-- Read/Edit Maintenance Alerts -->
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Maintenance_Alert__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>

    <!-- Equipment__c -->
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Equipment__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>

    <!-- Parts_Inventory__c -->
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Parts_Inventory__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>

    <!-- Job_Schedule__c -->
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>true</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Job_Schedule__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>

    <!-- Maintenance_Recommendation__c -->
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Maintenance_Recommendation__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>

    <!-- Smart Assignment + Dispatch Board access -->
    <classAccesses>
        <apexClass>F360_SmartAssignmentAction</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>F360_DispatchBoardController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>F360_PredictiveMaintenanceAction</apexClass>
        <enabled>true</enabled>
    </classAccesses>

    <!-- User field read access for dispatcher -->
    <fieldPermissions>
        <field>User.Skills__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>User.Is_Active__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>User.First_Time_Fix_Rate__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>User.Current_Latitude__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>User.Current_Longitude__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>User.Jobs_Completed_Total__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>User.Preferred_Language__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
</PermissionSet>
