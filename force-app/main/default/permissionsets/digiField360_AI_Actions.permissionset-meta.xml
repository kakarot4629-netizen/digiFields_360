<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>digiField360 AI Actions</label>
    <description>Grants Agentforce AI integration user execute access to all F360 Apex actions and full CRUD on F360 objects. Assign to the Agentforce agent integration user only.</description>
    <hasActivationRequired>false</hasActivationRequired>

    <!-- Full CRUD on Work Orders -->
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Work_Order__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>

    <!-- Read Technician records -->
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Technician__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>

    <!-- Create Job History (on WO completion) -->
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Job_History__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>

    <!-- Create and Edit Maintenance Alerts -->
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Maintenance_Alert__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>

    <!-- ContentVersion (service report PDF) -->
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>ContentVersion</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>

    <!-- Equipment__c -->
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Equipment__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>

    <!-- Parts_Inventory__c -->
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Parts_Inventory__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>

    <!-- Job_Schedule__c -->
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Job_Schedule__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>

    <!-- Maintenance_Recommendation__c -->
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Maintenance_Recommendation__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>

    <!-- All Apex class access -->
    <classAccesses>
        <apexClass>F360_PreJobBriefingAction</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>F360_ServiceReportAction</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>F360_TroubleshootingAction</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>F360_SmartAssignmentAction</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>F360_PredictiveMaintenanceAction</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>F360_BookingAgentAction</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>F360_DispatchBoardController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
</PermissionSet>
