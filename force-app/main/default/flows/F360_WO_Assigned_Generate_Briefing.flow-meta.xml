<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <actionCalls>
        <name>Generate_AI_Briefing</name>
        <label>Generate AI Briefing</label>
        <locationX>176</locationX><locationY>350</locationY>
        <actionName>F360_PreJobBriefingAction</actionName>
        <actionType>apex</actionType>
        <connector><targetReference>Log_Success_Task</targetReference></connector>
        <inputParameters>
            <name>workOrderId</name>
            <value><elementReference>$Record.Id</elementReference></value>
        </inputParameters>
        <inputParameters>
            <name>languageCode</name>
            <value><elementReference>techLang</elementReference></value>
        </inputParameters>
        <outputParameters>
            <assignToReference>briefingText</assignToReference>
            <name>briefingText</name>
        </outputParameters>
        <outputParameters>
            <assignToReference>briefingSuccess</assignToReference>
            <name>success</name>
        </outputParameters>
    </actionCalls>
    <decisions>
        <name>Check_Assigned_Status</name>
        <label>Is Work Order Assigned to Technician?</label>
        <locationX>176</locationX><locationY>150</locationY>
        <defaultConnectorLabel>Not Assigned</defaultConnectorLabel>
        <rules>
            <name>Is_Assigned</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue><stringValue>Assigned</stringValue></rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Assigned_Technician__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue><booleanValue>false</booleanValue></rightValue>
            </conditions>
            <connector><targetReference>Get_Technician_Language</targetReference></connector>
            <label>Assigned</label>
        </rules>
    </decisions>
    <description>When a Field360 Work Order status changes to Assigned and has an assigned technician, triggers the Pre-Job Briefing AI action asynchronously.</description>
    <interviewLabel>Field360 — Work Order Assigned: Generate AI Briefing {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Field360 — Work Order Assigned: Generate AI Briefing</label>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Log_Success_Task</name>
        <label>Log Briefing Generated Task</label>
        <locationX>176</locationX><locationY>470</locationY>
        <inputAssignments>
            <field>Subject</field>
            <value><stringValue>AI Pre-Job Briefing Generated</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value><elementReference>$Record.Id</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value><elementReference>$Record.Assigned_Technician__c</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value><stringValue>Completed</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <field>ActivityDate</field>
            <value><elementReference>$Flow.CurrentDate</elementReference></value>
        </inputAssignments>
        <object>Task</object>
    </recordCreates>
    <recordLookups>
        <name>Get_Technician_Language</name>
        <label>Get Technician Language</label>
        <locationX>176</locationX><locationY>250</locationY>
        <connector><targetReference>Generate_AI_Briefing</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value><elementReference>$Record.Assigned_Technician__c</elementReference></value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>User</object>
        <outputAssignments>
            <assignToReference>techLang</assignToReference>
            <field>Preferred_Language__c</field>
        </outputAssignments>
    </recordLookups>
    <start>
        <locationX>176</locationX><locationY>50</locationY>
        <object>Work_Order__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
        <connector>
            <targetReference>Check_Assigned_Status</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>briefingSuccess</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>briefingText</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>techLang</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value><stringValue>en</stringValue></value>
    </variables>
</Flow>
