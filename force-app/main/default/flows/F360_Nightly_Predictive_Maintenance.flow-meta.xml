    <decisions>
        <name>Check_Alerts_Created</name>
        <label>Any alerts created?</label>
        <locationX>176</locationX><locationY>254</locationY>
        <defaultConnectorLabel>No Alerts</defaultConnectorLabel>
        <rules>
            <name>Has_Alerts</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>alertsCreated</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue><numberValue>0</numberValue></rightValue>
            </conditions>
            <label>Has Alerts</label>
        </rules>
    </decisions>
    <description>Runs nightly. Calls the Predictive Maintenance AI action to analyse equipment job history, compute risk scores, and create Maintenance_Alert__c records for high-risk equipment.</description>
