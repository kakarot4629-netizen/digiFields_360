<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <description>When CSAT rating is 1 or 2, create follow-up task for Service Manager.</description>
    <label>DF360 - Low CSAT Alert</label>
    <processMetadataValues><name>BuilderType</name><value><stringValue>LightningFlowBuilder</stringValue></value></processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <status>Active</status>
    <interviewLabel>DF360 - Low CSAT Alert {!$Flow.CurrentDateTime}</interviewLabel>
    <start>
        <locationX>182</locationX><locationY>48</locationY>
        <connector><targetReference>Check_Low_Rating</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters><field>Is_Responded__c</field><operator>IsChanged</operator><value><booleanValue>true</booleanValue></value></filters>
        <filters><field>Is_Responded__c</field><operator>EqualTo</operator><value><booleanValue>true</booleanValue></value></filters>
        <object>CSAT__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <decisions>
        <name>Check_Low_Rating</name><label>Rating Is Low?</label>
        <locationX>182</locationX><locationY>158</locationY>
        <defaultConnectorLabel>Rating OK</defaultConnectorLabel>
        <rules>
            <name>Low_Rating</name><conditionLogic>1</conditionLogic>
            <conditions><leftValueReference>$Record.Rating__c</leftValueReference><operator>LessThanOrEqualTo</operator><rightValue><numberValue>2</numberValue></rightValue></conditions>
            <connector><targetReference>Create_Task</targetReference></connector><label>Rating 1 or 2</label>
        </rules>
    </decisions>
    <recordCreates>
        <name>Create_Task</name><label>Create Follow-up Task</label>
        <locationX>182</locationX><locationY>278</locationY>
        <inputAssignments><field>Subject</field><value><stringValue>Low CSAT — Immediate Follow-up Required</stringValue></value></inputAssignments>
        <inputAssignments><field>Priority</field><value><stringValue>High</stringValue></value></inputAssignments>
        <inputAssignments><field>Status</field><value><stringValue>Open</stringValue></value></inputAssignments>
        <inputAssignments><field>ActivityDate</field><value><elementReference>Tomorrow</elementReference></value></inputAssignments>
        <inputAssignments><field>WhatId</field><value><elementReference>$Record.Service_Job__c</elementReference></value></inputAssignments>
        <inputAssignments><field>Description</field><value><stringValue>Customer gave a low CSAT rating (1 or 2 stars). Contact customer within 24 hours to resolve.</stringValue></value></inputAssignments>
        <object>Task</object>
    </recordCreates>
    <formulas>
        <name>Tomorrow</name><dataType>Date</dataType>
        <expression>TODAY() + 1</expression>
    </formulas>
</Flow>
