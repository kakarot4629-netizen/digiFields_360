    {
      "name": "3. Get Technician Work Orders & Appointments (With Status, Team & Address)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "var jsonData = pm.response.json();",
              "pm.test('Response contains workOrders array', function () {",
              "    pm.expect(jsonData.workOrders).to.be.an('array');",
              "});",
              "",
              "if (jsonData.workOrders && jsonData.workOrders.length > 0) {",
              "    var wo = jsonData.workOrders.find(function(w) { return w.serviceAppointments && w.serviceAppointments.length > 0; }) || jsonData.workOrders[0];",
              "    if (wo.id) {",
              "        pm.collectionVariables.set('work_order_id', wo.id);",
              "        console.log('Saved work_order_id:', wo.id);",
              "    }",
              "    if (wo.serviceAppointments && wo.serviceAppointments.length > 0) {",
              "        var sa = wo.serviceAppointments[0];",
              "        pm.collectionVariables.set('service_appointment_id', sa.id);",
              "        pm.collectionVariables.set('service_appointment_status', sa.status);",
              "        console.log('Saved service_appointment_id:', sa.id, '| Status:', sa.status);",
              "        ",
              "        pm.test('Service Appointment contains valid status', function () {",
              "            pm.expect(sa.status).to.be.a('string').and.not.empty;",
              "        });",
              "        ",
              "        if (sa.assignedTeam && sa.assignedTeam.length > 0) {",
              "            console.log('Assigned Team Count:', sa.assignedTeam.length);",
              "            pm.test('Assigned Team roster is populated', function () {",
              "                pm.expect(sa.assignedTeam.length).to.be.above(0);",
              "            });",
              "        }",
              "    }",
              "    var addr = wo.serviceAddress || (wo.workOrder && wo.workOrder.serviceAddress) || (wo.case && wo.case.serviceAddress);",
              "    if (addr) {",
              "        console.log('Service Address:', addr.name, '| City:', addr.city, '| Lat:', addr.latitude, '| Lon:', addr.longitude);",
              "        pm.test('Customer Service Address is present', function () {",
              "            pm.expect(addr.name).to.be.a('string').and.not.empty;",
              "            pm.expect(addr.city).to.be.a('string').and.not.empty;",
              "        });",
              "        pm.test('Service Address contains valid latitude & longitude', function () {",
              "            pm.expect(addr.latitude).to.be.a('number');",
              "            pm.expect(addr.longitude).to.be.a('number');",
              "        });",
              "    }",
              "}",
              "",
              "pm.test(\"Service Appointment contains Scheduled or Start Time\", function () {",
              "    if (jsonData.workOrders && jsonData.workOrders.length > 0 && jsonData.workOrders[0].serviceAppointments && jsonData.workOrders[0].serviceAppointments.length > 0) {",
              "        var sa = jsonData.workOrders[0].serviceAppointments[0];",
              "        pm.expect(sa.scheduledStartTime).to.be.a(\"string\").and.not.empty;\n        console.log('   📅 Scheduled:', sa.scheduledStartTime, 'to', sa.scheduledEndTime);\n        console.log('   ⏱️ Actual (null if unstarted): Start =', sa.startTime, '| End =', sa.endTime);",
              "        console.log(\"   ⏰ SA Start Time:\", sa.startTime || sa.scheduledStartTime);",
              "        console.log(\"   ⏰ SA End Time:\", sa.endTime || sa.scheduledEndTime);",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{instance_url}}/services/apexrest/df360/v1/work-orders/my?technicianId={{technician_id}}&status=Assigned",
          "host": [
            "{{instance_url}}"
          ],
          "path": [
            "services",
            "apexrest",
            "df360",
            "v1",
            "work-orders",
            "my"
          ],
          "query": [
            {
              "key": "technicianId",
              "value": "{{technician_id}}",
              "description": "Filters strictly by the authenticated technician ID so only their work orders and appointments are returned."
            },
            {
              "key": "status",
              "value": "Assigned",
              "description": "Filters both Work Orders and child Service Appointments by status (e.g. Assigned, In Progress, On Site. Uncheck/remove to retrieve all assigned records)."
            }
          ]
        },
        "description": "Returns strictly assigned Work Orders and nested Service Appointments for the authenticated technician. Includes assigned multi-technician/crew team roster (`assignedTeam`) and customer service address (`workOrder.case.serviceAddress`). Filter by status using the status query param (default: Assigned)."
      },
      "response": []
    },
    {
      "name": "4. Get Service Appointment 360 Details (Multi-Assets, Parts, Crew & Address)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "var jsonData = pm.response.json();",
              "pm.test(\"Returns valid 360 Service Appointment\", function () {",
              "    pm.expect(jsonData.success).to.be.true;",
              "    pm.expect(jsonData.serviceAppointment).to.be.an(\"object\");",
              "    pm.expect(jsonData.serviceAppointment.id).to.eql(pm.collectionVariables.get(\"service_appointment_id\"));",
              "});",
              "",
              "var sa = jsonData.serviceAppointment;",
              "console.log(\"\\n--- 📱 SERVICE APPOINTMENT 360 DETAILS ---\");",
              "console.log(\"Name:\", sa.name, \"| Status:\", sa.status, \"| Priority:\", sa.priority);",
              "console.log(\"Piyush Channe Match: isAssignedToMe =\", sa.isAssignedToMe, \"| Type =\", sa.assignmentType);",
              "if (sa.myCrewAssignment) {",
              "    console.log(\"👥 Tagged Crew:\", sa.myCrewAssignment.crewName, \"| Role:\", sa.myCrewAssignment.role, \"| Leader:\", sa.myCrewAssignment.isLeader);",
              "}",
              "if (sa.primaryAsset) {",
              "    console.log(\"🏭 Primary Asset:\", sa.primaryAsset.name, \"-\", sa.primaryAsset.productName);",
              "}",
              "console.log(\"📦 Multi-Asset Line Items Count:\", sa.multiAssetLineItemsCount);",
              "if (sa.multiAssetLineItems && sa.multiAssetLineItems.length > 0) {",
              "    sa.multiAssetLineItems.forEach(function(item, idx) {",
              "        console.log(\"   \" + (idx + 1) + \". [\" + item.name + \"] \" + (item.asset ? item.asset.name : \"Asset\") + \": \" + item.description + \" (Status: \" + item.status + \")\");",
              "    });",
              "}",
              "console.log(\"🔩 Parts Requests Count:\", sa.partsRequestsCount);",
              "if (sa.partsRequests && sa.partsRequests.length > 0) {",
              "    sa.partsRequests.forEach(function(pr, idx) {",
              "        console.log(\"   \" + (idx + 1) + \". [\" + pr.name + \"] \" + pr.partName + \" (Qty: \" + pr.quantity + \", Status: \" + pr.status + \")\");",
              "    });",
              "}",
              "if (sa.serviceAddress) {",
              "    console.log(\"📍 Site Address:\", sa.serviceAddress.streetAddress + \", \" + sa.serviceAddress.city + \" | Contact:\", sa.serviceAddress.contactPerson, sa.serviceAddress.contactPhone);",
              "}",
              "",
              "pm.test(\"Piyush Channe unique identifier is populated\", function () {",
              "    pm.expect(sa.isAssignedToMe).to.be.true;",
              "    pm.expect(sa.assignmentType).to.be.a(\"string\").and.not.empty;",
              "});",
              "",
              "pm.test(\"Multi-Assets and Parts Requests are returned as arrays\", function () {",
              "    pm.expect(sa.multiAssetLineItems).to.be.an(\"array\");",
              "    pm.expect(sa.partsRequests).to.be.an(\"array\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{instance_url}}/services/apexrest/df360/v1/service-appointments/{{service_appointment_id}}?technicianId={{technician_id}}",
          "host": [
            "{{instance_url}}"
          ],
          "path": [
            "services",
            "apexrest",
            "df360",
            "v1",
            "service-appointments",
            "{{service_appointment_id}}"
          ],
          "query": [
            {
              "key": "technicianId",
              "value": "{{technician_id}}",
              "description": "Technician ID (e.g. Piyush Channe). Enables unique isAssignedToMe and crew match resolution."
            }
          ]
        },
        "description": "Returns complete 360-degree operational details for a Service Appointment including multi-asset checklists, requested parts, assigned crew roster, customer address, and Piyush Channe identifier flags."
      },
      "response": []
    },
