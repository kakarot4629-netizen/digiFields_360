### ═══════════════════════════════════════════════════════════════════════════
### 8.5 PRE-JOB SAFETY CHECK & HAZARD CLEARANCE (Screens 06, 08)
### ═══════════════════════════════════════════════════════════════════════════

### 8.5.1 Get Safety Checklist & Hazard Protocols (Screen 06)
GET {{baseUrl}}/api/work-orders/{{workOrderId}}/safety-check
Authorization: Bearer {{authToken}}

### 8.5.2 Submit Technician Safety Verification (Screen 08)
POST {{baseUrl}}/api/work-orders/{{workOrderId}}/safety-check
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "technicianId": "{{technicianId}}",
  "siteRiskLevel": "HIGH",
  "ppeVerified": {
    "dielectricGloves": true,
    "safetyGoggles": true,
    "steelToeBoots": true,
    "hardHat": true,
    "hearingProtection": true
  },
  "hazardChecks": [
    { "hazardCode": "LOTO_APPLIED", "verified": true },
    { "hazardCode": "ZERO_ENERGY_STATE", "verified": true },
    { "hazardCode": "BATTERY_ISOLATION", "verified": true },
    { "hazardCode": "FUEL_GAS_CLEAR", "verified": true },
    { "hazardCode": "EXHAUST_VENTILATION", "verified": true }
  ],
  "technicianDeclaration": "I confirm that all safety protocols and Lockout/Tagout measures have been verified before servicing this equipment.",
  "latitude": 18.52043,
  "longitude": 73.856743
}

### 8.5.3 Emergency Safety Escalation & Hazard Alert
POST {{baseUrl}}/api/work-orders/{{workOrderId}}/safety-escalation
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "hazardType": "ELECTRICAL_ARCING",
  "severity": "CRITICAL",
  "hazardDetails": "Active electrical arcing detected at main 415V distribution busbar with visible insulation scorch.",
  "immediateActionTaken": "Tripped upstream substation breaker and cordoned off 10-meter perimeter.",
  "evacuatedSite": true,
  "technicianId": "{{technicianId}}"
}

### 8.5.4 Get Equipment Safety Audit History
GET {{baseUrl}}/api/work-orders/{{workOrderId}}/safety-history
Authorization: Bearer {{authToken}}

### ═══════════════════════════════════════════════════════════════════════════
### 9. DYNAMIC WORK ORDER CHECKLIST & SENSOR TELEMETRY (Screen 17)
### ═══════════════════════════════════════════════════════════════════════════

### 9.1 Get Dynamic Work Order Checklist (Screen 17)
GET {{baseUrl}}/api/work-orders/{{workOrderId}}/checklist
Authorization: Bearer {{authToken}}

### 9.2 Update Single Checklist Item & Measurement Reading
PATCH {{baseUrl}}/api/work-orders/{{workOrderId}}/checklist/chk_5
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "status": "PASSED",
  "measuredValue": 415.2,
  "comments": "Phase-to-phase output voltage calibrated at 415.2V RMS within target tolerances."
}

### 9.3 Submit Completed Checklist Batch
POST {{baseUrl}}/api/work-orders/{{workOrderId}}/checklist/submit
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "items": [
    { "id": "chk_1", "isCompleted": true, "status": "PASSED" },
    { "id": "chk_2", "isCompleted": true, "status": "PASSED", "selected": "NORMAL" },
    { "id": "chk_3", "isCompleted": true, "status": "PASSED", "selected": "ADEQUATE" },
    { "id": "chk_4", "isCompleted": true, "status": "PASSED" },
    { "id": "chk_5", "isCompleted": true, "status": "PASSED", "measuredValue": 415.2 },
    { "id": "chk_6", "isCompleted": true, "status": "PASSED", "measuredValue": 78.4 },
    { "id": "chk_7", "isCompleted": true, "status": "PASSED", "measuredValue": 52.0 },
    { "id": "chk_8", "isCompleted": true, "status": "PASSED", "measuredValue": 12.8 },
    { "id": "chk_9", "isCompleted": true, "status": "PASSED" },
    { "id": "chk_10", "isCompleted": true, "status": "PASSED" },
    { "id": "chk_12", "isCompleted": true, "status": "PASSED" },
    { "id": "chk_13", "isCompleted": true, "status": "PASSED" },
    { "id": "chk_14", "isCompleted": true, "status": "PASSED" },
    { "id": "chk_15", "isCompleted": true, "status": "PASSED" },
    { "id": "chk_16", "isCompleted": true, "status": "PASSED" },
    { "id": "chk_17", "isCompleted": true, "status": "PASSED" },
    { "id": "chk_18", "isCompleted": true, "status": "PASSED" }
  ]
}

### 9.4 Get Standard Checklist Templates by Asset Category
GET {{baseUrl}}/api/checklist/templates
Authorization: Bearer {{authToken}}

