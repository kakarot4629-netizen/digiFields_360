  "partId": "PRT-001",
  "partCode": "TS-40",
  "partName": "Temperature Sensor TS-40",
  "quantity": 1,
  "isWarranty": true,
  "depot": "Pune Central Depot"
}

### 7.3 Track Parts Request Status (Screen 14)
GET {{baseUrl}}/api/jobs/{{workOrderId}}/parts-requests
Authorization: Bearer {{authToken}}

