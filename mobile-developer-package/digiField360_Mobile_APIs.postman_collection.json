            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"technicianId\": \"{{technicianId}}\",\n  \"mutations\": [\n    {\n      \"queueId\": \"UUID-OFFLINE-001\",\n      \"action\": \"status_update\",\n      \"sobjectName\": \"Work_Order__c\",\n      \"recordId\": \"{{workOrderId}}\",\n      \"fields\": { \"Status__c\": \"In Progress\" },\n      \"queuedAt\": \"2026-08-21T08:30:00Z\"\n    },\n    {\n      \"queueId\": \"UUID-OFFLINE-002\",\n      \"action\": \"time_log\",\n      \"sobjectName\": \"Work_Order__c\",\n      \"recordId\": \"{{workOrderId}}\",\n      \"fields\": { \"Time_Logged_Minutes__c\": 90 },\n      \"queuedAt\": \"2026-08-21T09:30:00Z\"\n    },\n    {\n      \"queueId\": \"UUID-OFFLINE-003\",\n      \"action\": \"complete\",\n      \"sobjectName\": \"Work_Order__c\",\n      \"recordId\": \"{{workOrderId}}\",\n      \"fields\": {\n        \"Status__c\": \"Completed\",\n        \"Technician_Notes__c\": \"Replaced sensor offline\",\n        \"Completed_Date__c\": \"2026-08-21T10:00:00Z\"\n      },\n      \"queuedAt\": \"2026-08-21T10:00:00Z\"\n    }\n  ]\n}"
