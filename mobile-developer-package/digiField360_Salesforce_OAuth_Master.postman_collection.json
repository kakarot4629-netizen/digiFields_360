  "item": [
    {
      "name": "1. ⚡ Instant 1-Click Access Token (Refresh Token Flow - 100% Verified)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test(\"Access Token successfully generated\", function () {",
              "    pm.expect(jsonData.access_token).to.be.a('string');",
              "});",
              "if (jsonData.access_token) {",
              "    pm.collectionVariables.set(\"accessToken\", jsonData.access_token);",
              "    if (pm.environment) { pm.environment.set(\"accessToken\", jsonData.access_token); }",
              "    console.log(\"✅ Fresh Live Access Token Auto-Captured:\", jsonData.access_token);",
              "}",
              "if (jsonData.instance_url) {",
              "    pm.collectionVariables.set(\"instanceUrl\", jsonData.instance_url);",
              "    if (pm.environment) { pm.environment.set(\"instanceUrl\", jsonData.instance_url); }",
              "    console.log(\"✅ Instance URL:\", jsonData.instance_url);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "grant_type",
              "value": "refresh_token",
              "type": "text"
            },
            {
              "key": "client_id",
              "value": "{{cliClientId}}",
              "type": "text"
            },
            {
              "key": "refresh_token",
              "value": "{{refreshToken}}",
              "type": "text"
            }
          ]
        },
        "url": {
          "raw": "{{instanceUrl}}/services/oauth2/token",
          "host": [
            "{{instanceUrl}}"
          ],
          "path": [
            "services",
            "oauth2",
            "token"
          ]
        },
        "description": "⚡ 100% Working & Verified: Generates a brand-new live Salesforce Access Token for System Admin Piyush Channe in 1 click using the refresh token flow without requiring passwords or security tokens."
      },
      "response": []
    },
    {
      "name": "2. 🔑 Username-Password Flow (Requires Security Token & Setup Enablement)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    var jsonData = pm.response.json();",
              "    if (jsonData.access_token) {",
              "        pm.collectionVariables.set(\"accessToken\", jsonData.access_token);",
              "        if (pm.environment) { pm.environment.set(\"accessToken\", jsonData.access_token); }",
              "        console.log(\"✅ Password Flow Access Token:\", jsonData.access_token);",
              "    }",
              "} else {",
              "    console.log(\"❌ Password Flow Error:\", pm.response.json());",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "grant_type",
              "value": "password",
              "type": "text"
            },
            {
              "key": "client_id",
              "value": "{{connectedAppClientId}}",
              "type": "text"
            },
            {
              "key": "client_secret",
              "value": "{{connectedAppClientSecret}}",
              "type": "text"
            },
            {
              "key": "username",
              "value": "{{username}}",
              "type": "text"
            },
            {
              "key": "password",
              "value": "{{password}}{{securityToken}}",
              "type": "text"
            }
          ]
        },
        "url": {
          "raw": "{{instanceUrl}}/services/oauth2/token",
          "host": [
            "{{instanceUrl}}"
          ],
          "path": [
            "services",
            "oauth2",
            "token"
          ]
        },
        "description": "Authenticates with username + password. If this returns invalid_grant, check: 1) 'Allow OAuth Username-Password Flows' is enabled in Setup -> OAuth and OpenID Connect Settings, and 2) Append your Salesforce Security Token."
      },
      "response": []
    },
    {
      "name": "3. 👤 Verify User Identity (UserInfo)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test(\"UserInfo contains valid user profile\", function () {",
              "    pm.expect(jsonData.preferred_username).to.be.a('string');",
              "    console.log(\"👤 Authenticated User:\", jsonData.name, \"(\" + jsonData.preferred_username + \")\");",
              "    console.log(\"🏢 Org ID:\", jsonData.organization_id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{instanceUrl}}/services/oauth2/userinfo",
          "host": [
            "{{instanceUrl}}"
          ],
          "path": [
            "services",
            "oauth2",
            "userinfo"
          ]
        },
        "description": "Calls Salesforce OAuth UserInfo endpoint to inspect the currently authenticated System Admin profile."
      },
      "response": []
    },
    {
