  "item": [
    {
      "name": "1. OAuth 2.0 Token (Auto-Sets Access Token)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.access_token) {",
              "    pm.collectionVariables.set('access_token', jsonData.access_token);",
              "    console.log('✅ Access Token automatically set to collection variables!');",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "grant_type",
              "value": "client_credentials",
              "type": "text"
            },
            {
              "key": "client_id",
              "value": "{{client_id}}",
              "type": "text"
            },
            {
              "key": "client_secret",
              "value": "{{client_secret}}",
              "type": "text"
            }
          ]
        },
        "url": {
          "raw": "{{instance_url}}/services/oauth2/token",
          "host": [
            "{{instance_url}}"
          ],
          "path": [
            "services",
            "oauth2",
            "token"
          ]
        },
        "description": "Authenticates and automatically sets the access_token variable for all other requests."
      },
      "response": []
    },
    {
      "name": "2. Get Service Appointment 360 Details (Multi-Assets, Parts, Crew & Address)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "var jsonData = pm.response.json();",
              "pm.test('Returns valid 360 Service Appointment', function () {",
              "    pm.expect(jsonData.success).to.be.true;",
              "    pm.expect(jsonData.serviceAppointment).to.be.an('object');",
              "});",
              "",
              "var sa = jsonData.serviceAppointment;",
              "console.log('📱 Service Appointment:', sa.name, '| Status:', sa.status);",
              "console.log('👤 Piyush Channe Unique Match: isAssignedToMe =', sa.isAssignedToMe, '| Type =', sa.assignmentType);",
              "if (sa.myCrewAssignment) {",
              "    console.log('👥 Tagged Crew:', sa.myCrewAssignment.crewName, '| Role:', sa.myCrewAssignment.role);",
              "}",
              "console.log('📦 Multi-Assets Count:', sa.multiAssetLineItemsCount);",
              "console.log('🔩 Parts Requests Count:', sa.partsRequestsCount);",
              "if (sa.beforePhoto) console.log('📷 Before Photo:', sa.beforePhoto.url);",
              "if (sa.afterPhoto) console.log('📸 After Photo:', sa.afterPhoto.url);",
              "if (sa.reason) console.log('🏷️ Reason:', sa.reason);",
              "if (sa.description) console.log('📝 Description:', sa.description);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{instance_url}}/services/apexrest/df360/v1/service-appointments/{{service_appointment_id}}?technicianId={{technician_id}}",
          "host": [
            "{{instance_url}}"
          ],
          "path": [
            "services",
            "apexrest",
            "df360",
            "v1",
            "service-appointments",
            "{{service_appointment_id}}"
          ],
          "query": [
            {
              "key": "technicianId",
              "value": "{{technician_id}}",
              "description": "Technician ID. Auto-resolves isAssignedToMe and crew match flags."
            }
          ]
        },
        "description": "Returns complete 360-degree operational details for a Service Appointment including multi-asset checklists, requested parts, assigned crew roster, customer address, and Piyush Channe identifier flags."
      },
      "response": []
    },
    {
      "name": "3a. Upload BEFORE Photo (Base64 Camera Evidence)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "var jsonData = pm.response.json();",
              "pm.test('Photo uploaded successfully', function () {",
              "    pm.expect(jsonData.success).to.be.true;",
              "    pm.expect(jsonData.photo).to.be.an('object');",
              "    pm.expect(jsonData.photo.photoUrl).to.be.a('string').and.not.empty;",
              "});",
              "",
              "console.log('📸 BEFORE Photo Saved:');",
              "console.log('   🔗 URL:', jsonData.photo.photoUrl);",
              "if (jsonData.photo.contentVersionId) {",
              "    console.log('   📁 Salesforce File ID:', jsonData.photo.contentVersionId);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"photoType\": \"Before\",\n  \"imageBase64\": \"iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==\",\n  \"fileName\": \"before_inspection.jpg\",\n  \"notes\": \"Pre-service visual inspection: slight oil seepage on bushing seal before overhaul.\"\n}"
        },
        "url": {
          "raw": "{{instance_url}}/services/apexrest/df360/v1/service-appointments/{{service_appointment_id}}/photos",
          "host": [
            "{{instance_url}}"
          ],
          "path": [
            "services",
            "apexrest",
            "df360",
            "v1",
            "service-appointments",
            "{{service_appointment_id}}",
            "photos"
          ]
        },
        "description": "Uploads Before photo evidence from mobile camera (base64) or hosted URL. Automatically creates Salesforce ContentVersion and stamps Before_Photo_URL__c on the Service Appointment."
      },
      "response": []
