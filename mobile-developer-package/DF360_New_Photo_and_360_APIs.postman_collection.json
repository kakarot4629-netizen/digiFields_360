{
  "info": {
    "_postman_id": "df360-new-photo-and-360-apis",
    "name": "DigiField 360 - New 360 Details, Photo & Incomplete APIs",
    "description": "Standalone collection containing only the newly created Service Appointment 360 Details, Before/After Photo Evidence, and Mark Incomplete APIs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "instance_url",
      "value": "https://orgfarm-4036b01401-dev-ed.develop.my.salesforce.com",
      "type": "string"
    },
    {
      "key": "client_id",
      "value": "3MVG97L7PWbPq6Uwn6NZQK1wxLkVSvXOdMLVbbhzid3miLmx9zhjZmuly4UrojOanINkPK2o0UPD8oXpw742j",
      "type": "string"
    },
    {
      "key": "client_secret",
      "value": "10E1BF442D1A8E91AC52210B41FC292E518A60C322FF72038F460B50EEB5683D",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
