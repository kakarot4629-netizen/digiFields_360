    {
      "name": "5. Mark Service Appointment Incomplete (with Description & Reason)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "var jsonData = pm.response.json();",
              "pm.test('Appointment marked incomplete successfully', function () {",
              "    pm.expect(jsonData.success).to.be.true;",
              "    pm.expect(jsonData.serviceAppointment.status).to.eql('Incomplete');",
              "    pm.expect(jsonData.serviceAppointment.description).to.not.be.empty;",
              "});",
              "",
              "console.log('⚠️ Appointment Status:', jsonData.serviceAppointment.status);",
              "console.log('📝 Description:', jsonData.serviceAppointment.description);",
              "console.log('🏷️ Reason:', jsonData.serviceAppointment.reason);",
              "if (jsonData.serviceAppointment.parentWorkOrder) {",
              "    console.log('⏸️ Parent Work Order Status:', jsonData.serviceAppointment.parentWorkOrder.status);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"description\": \"Technician could not complete calibration due to unexpected power shutdown by facility management. Requires reschedule.\",\n  \"reason\": \"Customer Unavailable\",\n  \"notes\": \"Spoke with facility manager Mr. Sharma; facility power will be restored tomorrow morning.\",\n  \"latitude\": 19.1136,\n  \"longitude\": 72.8697\n}"
        },
        "url": {
          "raw": "{{instance_url}}/services/apexrest/df360/v1/service-appointments/{{service_appointment_id}}/incomplete",
          "host": [
            "{{instance_url}}"
          ],
          "path": [
            "services",
            "apexrest",
            "df360",
            "v1",
            "service-appointments",
            "{{service_appointment_id}}",
            "incomplete"
          ]
        },
        "description": "Marks a Service Appointment as Incomplete with mandatory description and optional reason picklist. Automatically logs a Job Activity, SLA event, and pauses the parent Work Order."
