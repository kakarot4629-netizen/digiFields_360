        {
          "name": "0.2 Login & Obtain Bearer Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', function () { pm.response.to.have.status(200); });",
                  "var data = pm.response.json();",
                  "pm.test('Token returned', function () { pm.expect(data.token).to.be.a('string'); });",
                  "if (data.token) {",
                  "    pm.collectionVariables.set('accessToken', data.token);",
                  "    pm.collectionVariables.set('tokenExpiry', Date.now() + 3600000);",
                  "    if (data.technician) {",
                  "        pm.collectionVariables.set('technicianId', data.technician.id);",
                  "        pm.collectionVariables.set('technicianName', data.technician.name);",
                  "    }",
                  "    console.log('Saved token and technician profile.');",
                  "}"
                ]
              }
            }
          ],
