  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Auto-Authentication Pre-Request Script",
          "// Ensures valid accessToken is always present before any API call",
          "var baseUrl = pm.environment.get('baseUrl') || pm.collectionVariables.get('baseUrl') || 'https://digifields-360.onrender.com';",
          "var token = pm.environment.get('accessToken') || pm.collectionVariables.get('accessToken');",
          "var tokenExpiry = pm.environment.get('tokenExpiry') || pm.collectionVariables.get('tokenExpiry');",
          "var username = pm.environment.get('username') || 'piyush.channe.3868c7575da5@agentforce.com';",
          "var password = pm.environment.get('password') || 'India@2026#';",
          "",
          "var isAuthEndpoint = pm.request.url.getPath().indexOf('login') !== -1 || pm.request.url.getPath().indexOf('oauth') !== -1 || pm.request.url.getPath().indexOf('health') !== -1;",
          "",
          "if (!isAuthEndpoint && (!token || token.length < 10 || (tokenExpiry && Date.now() > Number(tokenExpiry)))) {",
          "    console.log('🔄 Auto-Authentication: Fetching fresh Bearer Token from: ' + baseUrl + '/api/auth/login');",
          "    pm.sendRequest({",
          "        url: baseUrl + '/api/auth/login',",
          "        method: 'POST',",
          "        header: { 'Content-Type': 'application/json' },",
          "        body: {",
          "            mode: 'raw',",
          "            raw: JSON.stringify({ username: username, password: password })",
          "        }",
          "    }, function (err, res) {",
          "        if (!err && res.code === 200) {",
          "            var data = res.json();",
          "            if (data.token) {",
          "                pm.collectionVariables.set('accessToken', data.token);",
          "                pm.collectionVariables.set('tokenExpiry', Date.now() + 3600000);",
          "                if (data.technician && data.technician.id) {",
          "                    pm.collectionVariables.set('technicianId', data.technician.id);",
          "                    pm.collectionVariables.set('technicianName', data.technician.name);",
          "                }",
          "                console.log('✅ Auto-Authentication Successful: Token refreshed.');",
          "            }",
          "        } else {",
          "            console.warn('⚠️ Auto-Authentication note: ' + (err ? err.message : ('HTTP ' + res.code)));",
          "        }",
          "    });",
          "}"
        ]
      }
    }
  ],
