          ],
          "query": [
            {
              "key": "q",
              "value": "SELECT Id, Name, Job_Type__c, Status__c, Priority__c, Account__r.Name, Technician__r.Name FROM Service_Job__c ORDER BY CreatedDate DESC LIMIT 10"
            }
          ]
        },
        "description": "Queries live Service Job records from Salesforce using the captured Bearer token."
      },
      "response": []
    },
    {
      "name": "6. 🚀 digiField360 Backend Login (Render)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test(\"JWT token returned\", function () {",
              "    pm.expect(jsonData.token).to.be.a('string');",
              "    console.log(\"🚀 digiField360 App JWT:\", jsonData.token);",
              "});"
            ],
